[Unit]
Description=Botfia light-switch control server
After=network.target

[Service]
Type=simple
User=milo
WorkingDirectory=/home/milo/botfia/pi
ExecStart=/home/milo/botfia/pi/.venv/bin/python -u /home/milo/botfia/pi/light_calibrate.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
